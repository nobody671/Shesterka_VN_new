translate english g1_1_prophet_and_shawarma_a6471455:

    # vova "Вот — точка А. Пирожок — копейки. А вот — точка Б."
    vova ""

# game/story/g1_1_prophet_and_shawarma.rpy:16
translate english g1_1_prophet_and_shawarma_18a33e02:

    # "Он указывает на их шестёрку."
    ""

# game/story/g1_1_prophet_and_shawarma.rpy:17
translate english g1_1_prophet_and_shawarma_3d446fb5:

    # vova "Наш транспорт. И точка В —"
    vova ""

# game/story/g1_1_prophet_and_shawarma.rpy:18
