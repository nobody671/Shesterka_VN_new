label g5_ending_calc:
    stop music
    scene black with fade
    
    "Семён смотрит на своих друзей. На сломанную машину. На свои руки."
    "Он сделал свой выбор."
    
    # Определяем, какая шкала строго выше двух остальных
    if ego > friend and ego > absurd:
        jump g5_ending_home
    elif friend > ego and friend > absurd:
        # TODO: написать сцену «Сгорание шестёрки»
        jump g5_ending_burn
    elif absurd > ego and absurd > friend:
        # TODO: написать сцену «Сон Вани»
        jump g5_ending_dream
    else:
        # Ничья между двумя шкалами — секретные ветки
        if friend == ego:
            jump g5_secret_garage        # «Союз с Володиным гаражом»
        elif friend == absurd:
            jump g5_secret_bar           # «Бар во время войны»
        else:  # ego == absurd
            jump g5_secret_shawarma      # «Шаверма Империя»


